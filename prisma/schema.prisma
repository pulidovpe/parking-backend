generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  DRIVER
  PARKING_MANAGER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ParkingStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum SpaceStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

// Enums de pagos
enum PaymentMethod {
  PAGO_MOVIL
  TRANSFERENCIA
  BINANCE_PAY
  CASHEA
  ZELLE
  EFECTIVO // Opcional, pago en garita
  OTRO
}

enum PaymentStatus {
  PENDING   // Usuario reportó el pago, esperando al Manager
  VERIFIED  // Manager confirmó que el dinero está en banco
  REJECTED  // Referencia falsa o no encontrada
  REFUNDED  // Reembolso
}

enum Currency {
  USD
  VES
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  firstName String     @map("first_name")
  lastName  String     @map("last_name")
  phone     String?
  role      UserRole   @default(DRIVER)
  status    UserStatus @default(ACTIVE)
  points    Int        @default(0)
  // NUEVO: Bandera para permitir post-pago (Usuarios recurrentes/premium)
  isPremium Boolean  @default(false)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")


  // Relaciones
  parkings Parking[]
  reservations Reservation[]
  transactions Transaction[] // Relación inversa

  loyaltyProfile LoyaltyProfile?  // El signo ? significa que es opcional (al inicio)

  @@map("users")
}

model Parking {
  id          String        @id @default(uuid())
  name        String
  description String?
  address     String
  city        String
  state       String
  zipCode     String?       @map("zip_code")
  latitude    Float
  longitude   Float
  // location será manejado con SQL raw queries para PostGIS

  // NUEVO: Tasa de cambio actual para este estacionamiento (ej. 36.50)
  exchangeRate Decimal @default(1.0) @db.Decimal(10, 2)
  location    Unsupported("geometry(Point, 4326)")?
  
  status      ParkingStatus @default(ACTIVE)
  hourlyRate  Float         @map("hourly_rate")
  imageUrl    String?       @map("image_url")
  
  // Información adicional
  hasMultipleLevels Boolean @default(false) @map("has_multiple_levels")
  totalLevels       Int     @default(1) @map("total_levels")
  
  // Horarios
  openingTime String? @map("opening_time") // formato HH:MM
  closingTime String? @map("closing_time") // formato HH:MM
  is24Hours   Boolean @default(false) @map("is_24_hours")
  
  // Relaciones
  managerId String @map("manager_id")
  manager   User   @relation(fields: [managerId], references: [id])
  
  levels    ParkingLevel[]
  spaces    ParkingSpace[]
  reservations Reservation[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([managerId])
  @@map("parkings")
}

model ParkingLevel {
  id          String @id @default(uuid())
  parkingId   String @map("parking_id")
  levelNumber Int    @map("level_number") // -2, -1, 0, 1, 2, etc.
  levelName   String @map("level_name") // "Sótano 2", "Planta Baja", "Piso 1"
  
  totalSpaces Int @default(0) @map("total_spaces")
  
  // Relaciones
  parking Parking        @relation(fields: [parkingId], references: [id], onDelete: Cascade)
  spaces  ParkingSpace[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([parkingId, levelNumber])
  @@index([parkingId])
  @@map("parking_levels")
}

model ParkingSpace {
  id            String      @id @default(uuid())
  parkingId     String      @map("parking_id")
  levelId       String?     @map("level_id")
  spaceNumber   String      @map("space_number") // "A-101", "B-205"
  status        SpaceStatus @default(AVAILABLE)
  
  // Información adicional
  isHandicapped Boolean @default(false) @map("is_handicapped")
  isElectric    Boolean @default(false) @map("is_electric")
  
  // Relaciones
  parking Parking       @relation(fields: [parkingId], references: [id], onDelete: Cascade)
  level   ParkingLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  
  reservations Reservation[]
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([parkingId, spaceNumber])
  @@index([parkingId])
  @@index([levelId])
  @@index([status])
  @@map("parking_spaces")
}

enum ReservationStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

model Reservation {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  parkingId       String            @map("parking_id")
  spaceId         String            @map("space_id")
  
  status          ReservationStatus @default(PENDING)
  
  // Tiempos
  startTime       DateTime          @map("start_time")
  endTime         DateTime?         @map("end_time")
  estimatedEndTime DateTime         @map("estimated_end_time")
  actualEndTime   DateTime?         @map("actual_end_time")
  
  // Costos
  hourlyRate      Float             @map("hourly_rate")
  estimatedCost   Float             @map("estimated_cost")
  actualCost      Float?            @map("actual_cost")
  
  // Metadata
  notes           String?
  cancellationReason String?        @map("cancellation_reason")
  
  // Relaciones
  user    User         @relation(fields: [userId], references: [id])
  parking Parking      @relation(fields: [parkingId], references: [id])
  space   ParkingSpace @relation(fields: [spaceId], references: [id])
  
  // NUEVO: Relación con transacciones (una reserva puede tener varios intentos de pago o pagos parciales)
  transactions Transaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([parkingId])
  @@index([spaceId])
  @@index([status])
  @@index([startTime])
  @@map("reservations")
}

// --- NUEVO MODELO TRANSACTION ---
model Transaction {
  id            String        @id @default(uuid())
  
  // Detalle Financiero
  amount        Decimal       @db.Decimal(10, 2) // Monto pagado
  currency      Currency      @default(VES)      // Moneda en la que pagó (usualmente VES en pago móvil)
  exchangeRate  Decimal       @default(1.0)      // Tasa usada al momento del pago
  amountInUsd   Decimal       @db.Decimal(10, 2) // Calculado para reportes (amount / exchangeRate)

  // Datos del Reporte
  referenceId   String        // El número de referencia del banco (clave para conciliar)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  notes         String?       // Nota del usuario o del manager (ej. "Pago desde banco Mercantil")

  // Para guardar detalles específicos (ej. email de binance, titular zelle)
  metadata      Json?

  // Relaciones
  reservationId String
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
  
  userId        String
  user          User          @relation(fields: [userId], references: [id])

  // Auditoría
  verifiedBy    String?       // ID del manager que verificó (opcional por ahora)
  verifiedAt    DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([reservationId])
  @@index([userId])
  @@index([status])
  @@index([referenceId]) // Importante para buscar rápido por referencia
}

// --- SISTEMA DE FIDELIDAD (FASE 1I) ---

enum LoyaltyTier {
  BRONZE   // Nivel inicial
  SILVER   // Beneficio: 5% descuento (ejemplo)
  GOLD     // Beneficio: 10% descuento
  PLATINUM // Beneficio: Prioridad + 15%
}

enum PointSource {
  RESERVATION_COMPLETED // Ganado por usar el parking
  REGISTRATION_BONUS    // Regalo de bienvenida
  MANUAL_ADJUSTMENT     // Ajuste por soporte técnico
  REDEMPTION            // Gasto de puntos (Canje)
}

model LoyaltyProfile {
  id             String       @id @default(uuid())
  pointsBalance  Int          @default(0) // Puntos actuales disponibles para gastar
  lifetimePoints Int          @default(0) // Total histórico acumulado (define el Nivel)
  tier           LoyaltyTier  @default(BRONZE)
  
  userId         String       @unique // Un usuario, un perfil de lealtad
  user           User         @relation(fields: [userId], references: [id])
  
  logs           LoyaltyLog[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model LoyaltyLog {
  id             String       @id @default(uuid())
  points         Int          // Cantidad (Positivo=Gana, Negativo=Gasta)
  source         PointSource
  description    String?      // Ej: "Reserva #123 finalizada"
  
  profileId      String
  profile        LoyaltyProfile @relation(fields: [profileId], references: [id])
  
  createdAt      DateTime     @default(now())
}